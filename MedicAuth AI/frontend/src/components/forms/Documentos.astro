---
import FileUpload from '../ui/FileUpload.astro';
---

<section class="bg-slate-700 rounded-xl p-6">
	<h2 class="text-xl uppercase font-semibold mb-6">
		Documentos
	</h2>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

		<FileUpload
			label="Informe médico PDF"
			name="informe_medico_url"
			required
			description="PDF, máx. 10 MB"
			icon="upload"
		/>

		<FileUpload
			label="Documentos adicionales"
			name="adicionales"
			description="PDF o imagen, máx. 10 MB"
			icon="images"
		/>

	</div>
</section>
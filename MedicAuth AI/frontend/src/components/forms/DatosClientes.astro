---
import Input from "../ui/Input.astro"

import {UserRound } from '@lucide/astro';
import Select from "../ui/Select.astro";
---

<section class="bg-slate-700 rounded-xl p-6">

        <div class="flex gap-4 items-center">
            <UserRound size={48} color="#46BE8C"/>
            <h2 class="text-xl uppercase font-semibold mb-6">
                Datos del paciente
            </h2>
        </div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <Input
                label="Nombre Completo"
                name="paciente_nombre"
                placeholder="Ingresa el nombre completo"
                required
            />

            <Input
                label="Edad"
                name="edad"
                placeholder="0987654321"
                type="number"
                required
            />

            <Input
                label="Cedula"
                name="cedula"
                placeholder="0987654321"
                type="number"
                required
            />

            <Select
                label="Medico Tratante"
                name="medico_tratante"
                required
                options={[
                    'Dr. Juan Perez',
                    'Dra. Isabella Ramirez ',
                    'Dr. Christian Arguello',
                    'Dr. Juan Narvaez'
                ]}
            />
        </div>

</section>
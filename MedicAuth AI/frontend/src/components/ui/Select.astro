---
interface Props {
	label: string;
	name: string;
	options: string[];
	required?: boolean;
}

const {
	label,
	name,
	options,
	required = false
} = Astro.props;
---

<div class="flex flex-col gap-2">
	<label for={name} class="font-medium text-sm">
		{label}

		{required && (
			<span class="text-red-500">*</span>
		)}
	</label>

	<select
		id={name}
		name={name}
		required={required}
		class="bg-white text-black border border-slate-600 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-emerald-400"
	>
		<option value="">Selecciona una opción</option>

		{options.map((option) => (
			<option value={option}>{option}</option>
		))}
	</select>
</div>
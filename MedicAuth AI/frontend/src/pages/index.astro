---
import CirugiaCentroMedico from "../components/forms/CirugiaCentroMedico.astro";
import DatosClientes from "../components/forms/DatosClientes.astro";
import Documentos from "../components/forms/Documentos.astro";
import PolizaSeguro from "../components/forms/PolizaSeguro.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";

import { Stethoscope, CheckCircle } from "@lucide/astro";
---

<Layout>
	<Header />

	<section class="space-y-2 mb-8">
		<div class="flex gap-4 items-center text-3xl">
			<Stethoscope size={64} color="#D0D0D1" />
			<h1>Nueva solicitud de autorización</h1>
		</div>

		<p class="text-slate-400">
			Completa los campos obligatorios antes de enviar la solicitud para
			revisión clínica
		</p>
	</section>

	<form id="medical-form" class="space-y-8">
		<DatosClientes />
		<CirugiaCentroMedico />
		<PolizaSeguro />
		<Documentos />
		<div class="flex justify-end gap-8 text-xl font-semibold">
			<button
				type="button"
				class="border hover:bg-slate-500 hover:text-white transition-colors ease-in px-8 py-2 rounded-lg cursor-pointer"
				>Cancelar</button
			>
			<button
				type="submit"
				id="submit-btn"
				class="bg-blue-500 hover:bg-blue-700 transition-colors ease-in text-white px-8 py-2 rounded-lg cursor-pointer"
				>Enviar Solicitud</button
			>
		</div>
	</form>

	<!-- Modal de Éxito -->
	<div id="success-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/20 backdrop-blur-sm opacity-0 invisible transition-all duration-300">
		<div class="bg-white rounded-2xl shadow-2xl max-w-md w-full mx-4 transform scale-95 transition-all duration-300" id="modal-content">
			<!-- Contenido del Modal -->
			<div class="p-8 text-center">
				<div class="bg-green-100 rounded-full p-4 w-20 h-20 mx-auto mb-6 flex items-center justify-center">
					<CheckCircle size={48} class="text-green-600" />
				</div>
				<h2 class="text-3xl font-bold text-gray-800 mb-3">¡Solicitud Enviada!</h2>
				<p class="text-gray-600 text-lg">Tu solicitud ha sido enviada correctamente.</p>
			</div>

			<!-- Footer del Modal -->
			<div class="p-6 border-t flex gap-3">
				<button id="new-request-btn" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold px-6 py-3 rounded-lg transition-colors">
					Nueva Solicitud
				</button>
				<button id="close-modal-btn-2" class="flex-1 bg-blue-500 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
					Cerrar
				</button>
			</div>
		</div>
	</div>
</Layout>

<script>
	const form = document.getElementById("medical-form");

	if (!(form instanceof HTMLFormElement)) {
		throw new Error('No se encontró el formulario con id "medical-form"');
	}

	const API = "https://medicauth-hackiathon.onrender.com";

	// ── Elementos del Modal ─────────────────────────────────────────
	const modal = document.getElementById("success-modal") as HTMLDivElement;
	const modalContent = document.getElementById("modal-content") as HTMLDivElement;
	const closeModalBtn2 = document.getElementById("close-modal-btn-2") as HTMLButtonElement;
	const newRequestBtn = document.getElementById("new-request-btn") as HTMLButtonElement;

	// ── Funciones del Modal ─────────────────────────────────────────
	function openModal() {
		modal.classList.remove("opacity-0", "invisible");
		modal.classList.add("opacity-100", "visible");
		modalContent.classList.remove("scale-95");
		modalContent.classList.add("scale-100");
		document.body.style.overflow = "hidden";
	}

	function closeModal() {
		modal.classList.add("opacity-0", "invisible");
		modal.classList.remove("opacity-100", "visible");
		modalContent.classList.add("scale-95");
		modalContent.classList.remove("scale-100");
		document.body.style.overflow = "auto";
	}

	// ── Event Listeners del Modal ───────────────────────────────────
	closeModalBtn2.addEventListener("click", closeModal);
	newRequestBtn.addEventListener("click", () => {
		closeModal();
		form.reset();
		document.querySelectorAll('[id^="filename-"]').forEach((el) => {
			el.textContent = "";
			el.classList.add("hidden");
		});
	});

	// Cerrar al hacer click fuera del modal
	modal.addEventListener("click", (e) => {
		if (e.target === modal) {
			closeModal();
		}
	});

	// Cerrar con tecla Escape
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && modal.classList.contains("visible")) {
			closeModal();
		}
	});

	// ── Funciones del Formulario ────────────────────────────────────
	async function subirPDF(file: File): Promise<string> {
		const pdfFormData = new FormData();
		pdfFormData.append("file", file);
		const res = await fetch(`${API}/api/authorization/upload-pdf`, {
			method: "POST",
			body: pdfFormData,
		});
		if (!res.ok) {
			const err = await res.json();
			throw new Error(err.detail || "Error al subir PDF");
		}
		const result = await res.json();
		console.log(`[PDF] Subido: ${result.url}`);
		return result.url;
	}

	form.addEventListener("submit", async (e) => {
		e.preventDefault();

		const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
		const originalText = submitBtn.textContent || "Enviar Solicitud";

		try {
			const formData = new FormData(form);

			// ── Validar informe médico (obligatorio) ─────────────────────
			const informeFile = formData.get("informe_medico_url");
			if (!(informeFile instanceof File) || informeFile.size === 0) {
				alert("Debes subir el informe médico en PDF");
				return;
			}
			if (!informeFile.name.toLowerCase().endsWith(".pdf")) {
				alert("El informe médico debe ser un archivo PDF");
				return;
			}

			// ── Póliza PDF (opcional) ─────────────────────────────────────
			const polizaFile = formData.get("documento_poliza");
			const tienePolizaPDF =
				polizaFile instanceof File &&
				polizaFile.size > 0 &&
				polizaFile.name.toLowerCase().endsWith(".pdf");

			// ── PASO 1: Subir informe médico ──────────────────────────────
			submitBtn.textContent = "Subiendo informe médico...";
			submitBtn.disabled = true;
			const informeUrl = await subirPDF(informeFile);

			// ── PASO 2: Subir documento de póliza (si existe) ─────────────
			let polizaUrl: string | null = null;
			if (tienePolizaPDF) {
				submitBtn.textContent = "Subiendo documento de póliza...";
				polizaUrl = await subirPDF(polizaFile as File);
			}

			// ── PASO 3: Crear solicitud en Notion ─────────────────────────
			submitBtn.textContent = "Creando solicitud en Notion...";

			const data = {
				paciente_nombre: formData.get("paciente_nombre")?.toString().trim(),
				cedula:          formData.get("cedula")?.toString().trim(),
				edad:            Number(formData.get("edad")),
				numero_poliza:   formData.get("numero_poliza")?.toString().trim(),
				tipo_cirugia:    formData.get("tipo_cirugia")?.toString().trim(),
				hospital:        formData.get("hospital")?.toString().trim(),
				medico_tratante: formData.get("medico_tratante")?.toString().trim(),
				fecha_solicitada:formData.get("fecha_solicitada")?.toString(),
				informe_medico_url: informeUrl,
				poliza_data: {
					aseguradora:   formData.get("aseguradora")?.toString().trim(),
					titular:       formData.get("titular")?.toString().trim(),
					tipo_plan:     formData.get("plan")?.toString().trim(),
					coberturas:    {},
					exclusiones:   [formData.get("exclusiones")?.toString().trim() || ""],
					carencia_dias: 90,
					fecha_inicio:  formData.get("fecha_inicio")?.toString() || "2025-01-01",
					fecha_fin:     formData.get("fecha_fin")?.toString() || "2026-01-01",
					documento_poliza_url: polizaUrl ?? undefined,
				},
			};

			console.log("[DATA] Solicitud a enviar:", data);

			const createRes = await fetch(`${API}/api/authorization/create`, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(data),
			});

			if (!createRes.ok) {
				const err = await createRes.json();
				throw new Error(err.detail || "Error al crear la solicitud");
			}

			const result = await createRes.json();
			console.log("[OK] Solicitud creada:", result);

			// ── Mostrar Modal en lugar de alert ────────────────────────
			openModal();

		} catch (error) {
			console.error("[ERROR]", error);
			alert(`Error: ${error instanceof Error ? error.message : "Error desconocido"}`);
		} finally {
			submitBtn.textContent = originalText;
			submitBtn.disabled = false;
		}
	});
</script>